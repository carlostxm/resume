---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { marked } from 'marked';

// Import CV.md as raw string (enables hot reload)
import cvMarkdown from '../CV.md?raw';

// Parse markdown to HTML at build time
const cvHtml = await marked.parse(cvMarkdown);

const title = 'Carlos Torres Martínez - Frontend Engineer';
const description = 'Frontend Engineer with 10+ years of experience in React, TypeScript, and modern web technologies';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			:root {
				--color-text: #1a1a1a;
				--color-text-light: #4a4a4a;
				--color-bg: #ffffff;
				--color-border: #e5e7eb;
				--color-link: #2563eb;
				--color-link-hover: #1d4ed8;
				--max-width: 56rem;
			}

			body {
				background: var(--color-bg);
				color: var(--color-text);
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
				line-height: 1.6;
				margin: 0;
				padding: 0;
			}

			main {
				max-width: var(--max-width);
				margin: 0 auto;
				padding: 3rem 1.5rem;
			}

			article h1 {
				font-size: 2.25rem;
				font-weight: 700;
				margin-bottom: 1rem;
				color: var(--color-text);
			}

			article h2 {
				font-size: 1.5rem;
				font-weight: 700;
				margin-top: 3rem;
				margin-bottom: 1.5rem;
				padding-bottom: 0.5rem;
				border-bottom: 2px solid var(--color-border);
				color: var(--color-text);
			}

			article h3 {
				font-size: 1.25rem;
				font-weight: 700;
				margin-top: 2rem;
				margin-bottom: 0.75rem;
				color: var(--color-text);
			}

			article p {
				color: var(--color-text-light);
				margin: 1rem 0;
			}

			article a {
				color: var(--color-link);
				text-decoration: none;
			}

			article a:hover {
				color: var(--color-link-hover);
				text-decoration: underline;
			}

			article strong {
				color: var(--color-text);
				font-weight: 600;
			}

			article ul {
				margin: 1rem 0;
			}

			article li {
				margin: 0.5rem 0;
			}

			article code {
				background: #f3f4f6;
				padding: 0.125rem 0.375rem;
				border-radius: 0.25rem;
				font-size: 0.875em;
			}

			@media (min-width: 768px) {
				main {
					padding: 5rem 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<article set:html={cvHtml} />
		</main>
		<Footer />
	</body>
</html>
